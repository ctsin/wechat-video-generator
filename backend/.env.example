# Copy to .env and adjust as needed.

# HTTP server
PORT=4000

# CORS origin for the Vite frontend
FRONTEND_ORIGIN=http://localhost:5173

# JWT signing secret (HS256). Override in production.
JWT_SECRET=dev-secret-please-change-me

# Public base URL used to build asset / render URLs returned to the client.
PUBLIC_BASE_URL=http://localhost:4000

# Set to "1" to dispatch real render jobs to AWS Lambda via @remotion/lambda.
# Without it, /api/preview/render and /api/render render locally via
# @remotion/renderer (a real playable MP4) so the full loop works without AWS.
REMOTION_LAMBDA_ENABLED=
REMOTION_AWS_REGION=us-east-1
REMOTION_BUCKET_NAME=
REMOTION_FUNCTION_NAME=

# AWS credentials for Remotion Lambda (deploy + render + download). Alternatively
# use standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an AWS_PROFILE.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Optional: pin an already-deployed site to skip per-process deploySite.
# REMOTION_SERVE_URL=https://<bucket>.s3.<region>.amazonaws.com/sites/wechat-video/index.html
# Site name used when the backend deploys the composition itself.
REMOTION_SITE_NAME=wechat-video

# Upload limits
MAX_BGM_BYTES=20971520
